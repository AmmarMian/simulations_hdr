# Various exports and data
**/export/
**/data/SAR
**/dev/
**/exports/
results

# Output plots and benchmark results
*.png
**/benchmark_results/

# hdr_exports/ IS tracked: it's the staged LaTeX figure hand-off point between
# machines (run experiments anywhere, commit hdr_exports/, pull on the machine
# with ../Dissertation, then rsync + `just figures`). Un-ignore its PNGs too.
!hdr_exports/**/*.png

# Mac os thumbnails
._*
._.DS_Store
.DS_Store

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.qanat

# AI assistant config/skills — keep the repo AI-tool-independent
.claude/

# MkDocs build output
site/
docs/site/

# Ad-hoc experiment outputs of 3-deeplearning (regenerable; the staged copies
# live in hdr_exports/ as for every other chapter).
3-deeplearning/**/outputs/

# Scratch run directories: every main.py defaults --storage-path to outputs/<name>,
# so a local run outside qanat leaves one behind. They are never the source of a
# figure — qanat runs land in results/ and figures are staged in hdr_exports/ —
# and an uncommitted one is enough to make `qanat experiment run` refuse to start.
**/outputs/

# Hyperspectral scenes: 38 MB of .mat files that download_scene() fetches on
# first use, so they were 38 MB of git history for nothing.
data/hyperspectral/
